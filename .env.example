# NightMail configuration template.
#
# Copy it to `.env` at the repository root (`cp .env.example .env`) and fill in what you need.
# `.env` is not versioned. Never commit a `.env` with real values.
#
# The server only reads the SECRETS (the first section) from this file, and reads them without
# passing them to the environment, so no child process inherits them. The remaining variables are read
# from the shell environment: export them before starting (`export NAME=value`) or put them in front of
# the command (`NAME=value npm run ...`). They are listed here commented out, with their default value, as
# a reference. All are optional except where stated.

# ---------------------------------------------------------------------------------------------
# Secrets (read from this file)
# ---------------------------------------------------------------------------------------------

# Blockfrost project key for Midnight's preprod network (indexer and node).
# Required only with NIGHTMAIL_NETWORK=preprod. Not needed on the local network (devnet).
BLOCKFROST_PROJECT_ID=

# ---------------------------------------------------------------------------------------------
# Operator server (apps/server): read from the shell environment
# ---------------------------------------------------------------------------------------------

# Network: `undeployed` (local devnet from infra/devnet) or `preprod`. Default: preprod.
# NIGHTMAIL_NETWORK=undeployed
# Where the server and the payer reach the local devnet and the proof server. The Docker backend
# (infra/backend) points them at the devnet containers. The node is a ws:// URL, the indexer an http:// URL
# (its WebSocket is <url>/ws), and the proof server is also used on preprod.
# NIGHTMAIL_DEVNET_NODE_URL=ws://127.0.0.1:9944
# NIGHTMAIL_DEVNET_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
# NIGHTMAIL_PROOF_SERVER_URL=http://127.0.0.1:6300

# Mail server (SMTP intake and the mailbox API). It only listens on 127.0.0.1.
# Address the mail server, the issuer and the relayer listen on: 127.0.0.1, or 0.0.0.0 only inside a Docker
# container (the Docker backend, which publishes the ports on 127.0.0.1 only).
# NIGHTMAIL_LISTEN_HOST=127.0.0.1
# Domain of the addresses.
# NIGHTMAIL_MAIL_DOMAIN=nightmail.local
# Inbound SMTP port.
# NIGHTMAIL_SMTP_PORT=2525
# Mailbox API port (the app downloads mail from here).
# NIGHTMAIL_API_PORT=8787
# Public URL of that API, if it is not http://127.0.0.1:<port>.
# NIGHTMAIL_API_URL=http://127.0.0.1:8787
# 1 if there is a reverse proxy in front of the API (the client IP for its per-IP limits, including those
# of anonymous delivery, then comes from the proxy's header). Leave it at 0 without a proxy: a client could
# otherwise choose its own IP. Through Tor or an onion service, per-IP limits cannot tell clients apart
# either way: there only the per-mailbox and overall limits protect the server.
# NIGHTMAIL_API_TRUSTED_PROXY=0
# Verbose logging (1 = on, unset = off).
# NIGHTMAIL_DEBUG=1

# Plan issuer. The CAPTCHA and the card payment are SIMULATED in this version:
# they are accepted if the client sends these tokens. Change them outside a local demo.
# NIGHTMAIL_ISSUER_PORT=8788
# NIGHTMAIL_ISSUER_CAPTCHA_TOKEN=nightmail-demo-captcha
# NIGHTMAIL_ISSUER_CARD_TOKEN=tok_nightmail_demo
# 1 if there is a reverse proxy in front (the client IP then comes from its header).
# NIGHTMAIL_ISSUER_TRUSTED_PROXY=0
# Plan sign-ups (free and paid) per hour in total.
# NIGHTMAIL_ISSUER_GLOBAL_PER_HOUR=100
# With this many pending sign-ups, new ones get "busy".
# NIGHTMAIL_ISSUER_MAX_PENDING=100
# Maximum round advances per hour.
# NIGHTMAIL_ISSUER_MAX_ADVANCES_PER_HOUR=60

# Public relayer (sends the app's proofs to the chain, and the operator pays the fee).
# Provisional values: the production caps are yet to be decided.
# NIGHTMAIL_RELAYER_PORT=8789
# NIGHTMAIL_RELAYER_TRUSTED_PROXY=0
# Transactions accepted per IP and hour.
# NIGHTMAIL_RELAYER_PER_IP_PER_HOUR=20
# Transactions accepted per hour in total.
# NIGHTMAIL_RELAYER_GLOBAL_PER_HOUR=300
# Attempts (valid or not) per IP and hour.
# NIGHTMAIL_RELAYER_ATTEMPTS_PER_IP_PER_HOUR=60
# Transactions rejected through the client's fault, per IP and hour.
# NIGHTMAIL_RELAYER_FAULTS_PER_IP_PER_HOUR=3
# Rejections per hour in total. Once reached, the relayer answers "busy" for the rest of the hour.
# NIGHTMAIL_RELAYER_REJECTED_PER_HOUR=100
# Maximum random delay before forwarding a transaction, in milliseconds.
# NIGHTMAIL_RELAYER_MAX_DELAY_MS=20000
# Maximum transactions in flight at once.
# NIGHTMAIL_RELAYER_MAX_IN_FLIGHT=8

# Payer (a separate process holding the operator's wallet). Caps in whole DUST.
# Cap on what the relayer pays in an hour.
# NIGHTMAIL_PAYER_RELAY_DUST_PER_HOUR=100
# Cap on what plan issuing pays in an hour.
# NIGHTMAIL_PAYER_ISSUE_DUST_PER_HOUR=50
# Operations in flight plus waiting (1 to 10000).
# NIGHTMAIL_PAYER_MAX_QUEUE=32

# ---------------------------------------------------------------------------------------------
# Desktop app (debug build, local network): read from the environment
# ---------------------------------------------------------------------------------------------

# REQUIRED: fingerprint of the key with which the issuer signs receipts. The mail server prints it on
# startup (a line with `sha256:`).
# NIGHTMAIL_ISSUER_RECEIPT_KEY=sha256:
# Address of the registry contract (32-byte hex). By default it is read from NIGHTMAIL_CONTRACTS_FILE.
# NIGHTMAIL_REGISTRY_ADDRESS=
# Deployment file. Default: .data/operator/undeployed/contracts.json in the repository.
# NIGHTMAIL_CONTRACTS_FILE=
# Profile folder (the app's encrypted data). Default: the system data folder.
# NIGHTMAIL_PROFILE_DIR=
# Operator services (https or local addresses only).
# NIGHTMAIL_MAIL_DOMAIN=nightmail.local
# NIGHTMAIL_API_URL=http://127.0.0.1:8787
# NIGHTMAIL_ISSUER_URL=http://127.0.0.1:8788
# NIGHTMAIL_RELAYER_URL=http://127.0.0.1:8789
# Simulated tokens (the same as on the server).
# NIGHTMAIL_ISSUER_CAPTCHA_TOKEN=nightmail-demo-captcha
# NIGHTMAIL_ISSUER_CARD_TOKEN=tok_nightmail_demo
# Midnight helper process (debug build only): Node 24 executable and its folder.
# NIGHTMAIL_NODE=node
# NIGHTMAIL_SIDECAR_DIR=apps/midnight-sidecar

# ---------------------------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------------------------

# Re-records the proof server responses used by the sidecar tests (1 = yes).
# NIGHTMAIL_RECORD_PROOFS=1
# Runs the devnet test that waits about 17 minutes for a price window to end (1 = yes).
# NIGHTMAIL_GRACE_WAIT=1
# Mailbox API for the Rust test against the real server.
# NIGHTMAIL_MAILBOX_URL=http://127.0.0.1:8787
